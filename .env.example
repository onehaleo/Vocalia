# =============================================================================
# Vocalia — environment variables
#
# Naming: Prefer NEXT_PUBLIC_SUPABASE_ANON_KEY below (matches Supabase docs).
#         NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY still works if set instead.
#
# Environment split:
# - Local:      Stripe TEST keys + staging/dev Supabase project + NEXT_PUBLIC_APP_ENV=local
# - Staging:    Stripe TEST keys + staging/dev Supabase + NEXT_PUBLIC_APP_ENV=staging
#               marketing: staging.speakvocalia.com, app: beta-staging.speakvocalia.com
# - Production: Stripe LIVE keys + production Supabase + NEXT_PUBLIC_APP_ENV=production
#               marketing: speakvocalia.com (+ www), app: beta.speakvocalia.com
#
# Never commit .env.local. Never put the service role key in NEXT_PUBLIC_*.
# =============================================================================

# --- App (client-safe) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=local
# Marketing CTAs route to beta app. Defaults to https://beta.speakvocalia.com when unset.
NEXT_PUBLIC_BETA_APP_URL=https://beta.speakvocalia.com
# Root / marketing domain used for "Back to Vocalia" links and marketing-only sections.
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000

# --- Supabase (client-safe URL + anon; service role is server-only) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional alternative to anon (newer Supabase naming). If both are set, publishable wins in code.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe: publishable is client-safe; the rest are server-only ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One-time checkout (mode=payment): price_… or prod_… with a one-time default price
STRIPE_PRICE_ID=

# =============================================================================
# Vercel (placeholders) — set in Project → Settings → Environment Variables
# Redeploy after changing env vars.
#
# Production (main → beta.speakvocalia.com), example:
#   vercel env add NEXT_PUBLIC_APP_ENV production
#   vercel env add NEXT_PUBLIC_APP_URL production
#   vercel env add NEXT_PUBLIC_SUPABASE_URL production
#   vercel env add NEXT_PUBLIC_SUPABASE_ANON_KEY production
#   vercel env add NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY production
#   vercel env add SUPABASE_SERVICE_ROLE_KEY production
#   vercel env add STRIPE_SECRET_KEY production
#   vercel env add STRIPE_WEBHOOK_SECRET production
#   vercel env add STRIPE_PRICE_ID production
#
# Staging / Preview (staging branch):
#   marketing: staging.speakvocalia.com
#   app: beta-staging.speakvocalia.com
#   vercel env add NEXT_PUBLIC_APP_ENV preview
#   vercel env add NEXT_PUBLIC_APP_URL preview
#   vercel env add NEXT_PUBLIC_BETA_APP_URL preview
#   ... (same variables as above with staging/dev Supabase + Stripe TEST keys)
#
# Pull env locally (requires login):
#   vercel env pull .env.local
# =============================================================================

# =============================================================================
# Supabase Auth URL configuration (Dashboard → Authentication → URL config)
#
# Local:
#   Site URL: http://localhost:3000
#   Redirect: http://localhost:3000/auth/callback
#
# Staging:
#   Site URL: https://staging.speakvocalia.com
#   Redirect: https://staging.speakvocalia.com/auth/callback
#   (If auth should happen on app host instead, use beta-staging.speakvocalia.com accordingly)
#
# Production (beta):
#   Site URL: https://beta.speakvocalia.com
#   Redirect: https://beta.speakvocalia.com/auth/callback
# =============================================================================

# =============================================================================
# Stripe webhooks (Dashboard → Developers → Webhooks)
# - Staging (Stripe TEST mode): https://beta-staging.speakvocalia.com/api/stripe/webhook
# - Production (Stripe LIVE mode): https://beta.speakvocalia.com/api/stripe/webhook
# Event: checkout.session.completed (minimum)
# =============================================================================
