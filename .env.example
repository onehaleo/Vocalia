# Public — use Supabase publishable key (Dashboard → API → publishable)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy (optional): still supported if publishable key is not set
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Server-only
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# One-time checkout (mode=payment): set a Price id (price_…) OR a Product id (prod_…) with a one-time default/first price.
# Stripe Dashboard → Product catalog → one-time price → copy price_… (preferred)
STRIPE_PRICE_ID=
