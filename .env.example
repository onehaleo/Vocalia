# =============================================================================
# Copy into Vercel → Project → Settings → Environment Variables (Production)
# Domain: https://speakvocalia.com
# =============================================================================
#
# NEXT_PUBLIC_APP_URL=https://speakvocalia.com
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=
#
# Supabase Auth → URL configuration:
#   Site URL: https://speakvocalia.com
#   Redirect URLs: https://speakvocalia.com/auth/callback
#
# Stripe Dashboard → Webhooks (production):
#   https://speakvocalia.com/api/stripe/webhook
#
# =============================================================================
# Local development — copy this file to .env.local and fill values
# =============================================================================

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy (optional): still supported if publishable key is not set
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Server-only
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
# Required in production for /api/stripe/webhook. Local: npm run stripe:listen → paste whsec_…
STRIPE_WEBHOOK_SECRET=

# One-time checkout (mode=payment): set a Price id (price_…) OR a Product id (prod_…) with a one-time default/first price.
# Stripe Dashboard → Product catalog → one-time price → copy price_… (preferred)
STRIPE_PRICE_ID=
